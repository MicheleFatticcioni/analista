// crewai-eval — what "good" means for this crew.
//
// Written from your last run: every criterion below is a task's own
// `expected_output`, which is the bar the crew set for itself. Say what YOU
// want judged and the next `crewai eval` uses it.
//
// Each entry in `criteria` is one yes/no question about the final output, asked
// and answered on its own. Write them so they can be answered from the output
// alone — specific to this crew's job, not "is it well written".
//
// `task_criteria` and `agent_criteria` ask about one step instead: keyed by a
// task's name or an agent's role, judged against that step's own output.
//
// `assertions` are checked in code, never by a judge: contains, not_contains,
// regex, min_length, json_parses.
{
  "schema": "crewai.eval/v1",
  "dataset": [
    {
      "id": "trace-1",
      "inputs": {
        "pitch_path": "file/Pitch.pdf",
        "pitch": {
          "source": {
            "path": "file/Pitch.pdf"
          },
          "mode": "auto"
        }
      },
      "expected_output": "A markdown report of about 1000 words with the analysis, organized in these sections: Unique elements (the features that make the game unique), Competitors (a summary of the main competitors and what they have in common), Target (the characteristics of the users interested in the game).",
      "criteria": [
        "The report has three sections: unique elements, competitors and target audience.",
        "The unique elements are features, mechanics or lore items from the pitch extraction, and the report explains why the similar games do not share them.",
        "The competitors section names the games found by search_similar_games_task and states what they have in common with each other and with the pitch.",
        "The target section describes the interested users with concrete characteristics (play style, experience, preferred genre or tone), each tied to an element of the pitch or of the competitors.",
        "The report separates what the data states from the analyst's inference, and says how the gaps in the pitch extraction limit the assessment.",
        "Disqualifier, applied only when the report quotes it: a sales figure, crowdfunding result or player count that appears in neither the previous task outputs nor a cited source.",
        "Disqualifier, applied only when the report shows it: a competitor that search_similar_games_task did not list."
      ],
      "task_criteria": {
        "search_similar_games_task": [
          "Every listed game is a published tabletop role-playing game, not a video game, and is not the pitched game itself.",
          "Every listed game has at least 2 shared elements, and at least one of them is a core feature or a mechanic of the pitch, not only genre or lore.",
          "Every shared element names an item that exists in the pitch extraction and describes how the game implements it.",
          "Disqualifier, applied only when a quoted tool result shows it: a listed game, publisher or shared feature is contradicted by the page fetched from its source URL, or the run fetched no page from a listed source URL.",
          "If fewer than 5 games are listed, notes explain why instead of saying 'none'."
        ],
        "extract_pitch_task": [
          "The extraction gives the pitch's title, a one-line description, genre, core features, mechanics and lore, each item with a source_ref, plus a search_summary with 5-8 keywords and the list of gaps.",
          "Disqualifier: an item states something the pitch document does not say."
        ]
      }
    }
  ]
}
