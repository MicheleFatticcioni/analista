{
  // Display name for this crew
  "name": "valutatore",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["reader", "researcher", "market", "presenter"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Extracts mechanics, core features and lore from the pitch.
      // valutatore.callbacks.load_pitch attaches the PDF at {pitch_path} as the file 'pitch'.
      "name": "extract_pitch_task",
      "description": "Read the attached pitch document (file 'pitch') in full. Its text, extracted from the PDF, is:\n<<<\n{pitch_text}\n>>>\n A pitch is a short, persuasive presentation of a role-playing game: your job is to extract what makes this game distinctive.\nExtract:\n1. title and a one-line description of the game.\n2. core_mechanics: the mechanics and features that set this game apart, weighing what the pitch emphasizes. Do not list what every RPG has (player characters, dice, a game master, a setting).\n3. system: the game system (e.g. Year Zero Engine, d20 System, PbtA). If the pitch names it, set system_inferred=false. If it does not but the text clearly points to one, write it and set system_inferred=true. If there is no indication, write \"not specified\" and system_inferred=false.\n4. lore: the setting, in at most 200 characters.\n5. lang: the language the pitch is written in, as an ISO 639-1 code.\nWrite every text field (description, names and descriptions of the core mechanics, lore) in the language of the pitch.\nStay close to the text. Inference is allowed but must be minimal: mark inferred=true on any core mechanic the pitch implies without stating, and use it only when the document clearly supports it. Never add elements with no basis in the document.",
      "expected_output": "The pitch's title, a one-line description, core_mechanics (each with a description and an inferred flag), system with its inferred flag, lore and lang, all grounded in the document.",
      "output_pydantic": { "python": "valutatore.models.PitchExtraction" },
      "agent": "reader",

      // Optional task guardrail(s) validate output before completion
      // "guardrail": "Every factual claim needs context support.",
      // "guardrail_max_retries": 2,
      // Docs: https://docs.crewai.com/concepts/tasks
    },
    {
      // Builds specific search keywords from the pitch and finds up to 5 published tabletop RPGs similar to it.
      "name": "search_similar_games_task",
      "description": "Using the pitch extraction from the previous task, find published tabletop role-playing games (not video games) similar to the pitch.\n1. Build search keywords, in English:\n   - up to 3 mid or long keywords from the game description, each of 2 to 5 words (count them: more than 5 words is wrong; shorten the keyword instead of adding words);\n   - up to 2 keywords from the core_mechanics, each describing a distinctive mechanic together with a theme;\n   at most 5 keywords in total.\n2. Each keyword must be specific: combine at least two distinct concepts (for example theme + mechanic). Never search only by game system, genre or a single generic word; the system may appear only as part of a longer keyword. Add \"tabletop RPG\" to every search so video games are excluded, but do not write it inside the keyword you report.\n3. Run all the searches together, in a single step, one per keyword.\n4. From the results, pick games that really match the keyword. Open the candidate pages together, in a single step, to confirm the game exists and to read the publisher. Exclude the pitched game itself.\n5. For each game report: title, a description taken from the source and written in the language of the pitch (lang), hard limit 100 characters, aim for about 80 (count them, a longer one makes the output invalid), the URL of a page that names the game itself (never a site home page or a generic list page when a page about the game exists), the publisher copied exactly as that page writes it, without adding words such as Publishing or Games (write \"not found\" if no page names it; never use your own knowledge). Take the publisher only from the game's own page (publisher, official or store page): the author of a marketplace listing is not the publisher unless the page says it is self-published, and a list article or review site that mentions the game says nothing about its publisher, and the keyword that led to it.\nReturn at most 5 games, ordered from most to least similar. Never invent a game, a link or a publisher. If you find fewer than 5, say why in message (written in the language of the pitch), and when you list 5 games message is \"none\"; if you find none, write \"no games found\" in message and return an empty list.",
      "expected_output": "Up to 5 real tabletop RPGs similar to the pitch, each with title, description (max 100 characters), source URL, publisher ('not found' if no page names it) and the keyword used; plus all keywords searched and a message that says 'no games found' when the list is empty.",
      "output_pydantic": { "python": "valutatore.models.SimilarGamesResult" },
      "agent": "researcher",
      "guardrail": { "python": "valutatore.guardrails.check_similar_games" },
      "guardrail_max_retries": 2,
    },
    {
      // Judges the pitch's market position from the two previous outputs and writes the report.
      "name": "market_analysis",
      "description": "Using the pitch information from extract_pitch_task (title, description, core_mechanics, system, lore, lang) and the similar games from search_similar_games_task (title, description, publisher, source, keyword), assess the game's potential success and its position in the market. Base the assessment on the data you received: this task asks you to reason over it and build an analysis, not to collect new data.\nThe report must contain exactly three sections, each introduced by a Markdown heading written in the language of the pitch (lang): the three titles are \"Unique elements\", \"Competitors\" and \"Target\", translated into that language (for Italian: \"## Elementi unici\", \"## Concorrenti\", \"## Target\"). The order of the sections does not matter, but none may be missing.\nWrite the whole report in the language of the pitch, basis markers included (for Italian: \"(dati: <task name>, <item>)\" and \"(inferenza)\").\nCover the three sections as follows:\n- Unique elements: the core mechanics, system and lore elements that none of the similar games appear to share, or that the pitch combines in a way none of them does. Also say which elements are not clearly distinctive, because the similar games offer something comparable.\n- Competitors: what the similar games have in common with each other and with the pitch, and where the pitch differs or falls short.\n- Target: who the target audience is, based on the elements above.\nState strengths and weaknesses with the same plainness: do not favour the game.\nEnd every statement with its basis: \"(data: <task name>, <item>)\" when the previous outputs state it, or \"(inference)\" when it is your reasoning over them. Name only competitors listed by search_similar_games_task, and describe them only with what that task's output states (a short description, a publisher, a keyword); if it says nothing about an aspect, do not describe it.\nThe data has no sales, crowdfunding, player-count or market-trend figures: do not state any, and do not call a segment growing, large, niche or underserved or say a fanbase exists. Judge the potential success only by how the game's unique elements position it against the listed competitors, marked as inference. The pitch extraction marks as inferred (inferred=true) what the extractor interpreted rather than read: say how this limits the assessment where it matters. If no similar game was found, say that the competitor analysis cannot be done.",
      "expected_output": "A markdown report of about 1000 words with the analysis, organized in these sections:\n- Unique elements: the features that make the game unique.\n- Competitors: a summary of the main competitors and what they have in common.\n- Target: the characteristics of the users interested in the game.",
      "context": ["extract_pitch_task", "search_similar_games_task"],
      "markdown": true,
      "output_file": "output/market_analysis.md",
      "agent": "market",
    },
    {
      // Summarizes the previous outputs into an impartial report for the publisher.
      "name": "publisher_report_task",
      "description": "Write the report for the publisher using only the outputs of the previous tasks. Write everything in the language of the pitch (lang), headings included: the headings below are given in Italian and must be translated if the pitch is in another language. Use exactly this structure:\n# <game title>\n## Descrizione\nA description of the game of about 200 words, from the pitch extraction (description, core mechanics, system and lore).\n## Giochi simili\nA bulleted list, one bullet per similar game found by search_similar_games_task, as \"Title (publisher)\"; write \"publisher not found\" (translated into the language of the pitch) when the publisher is 'not found'. If no game was found, say so in one line.\n## Punti di forza e debolezza\nA summary of the market analysis: what the game does well compared with the competitors (strengths) and where it is weak or limited (weaknesses), in two bulleted lists. Weaknesses must be stated as plainly as strengths.\nBe impartial: no promotional language. Name only games from the similar games list. Do not add figures, facts or opinions that the previous outputs do not state; if the analysis does not settle a point, leave it out.",
      "expected_output": "A markdown report with the game title as heading and the three sections Descrizione (about 200 words), Giochi simili and Punti di forza e debolezza, based only on the previous tasks.",
      "context": ["extract_pitch_task", "search_similar_games_task", "market_analysis"],
      "markdown": true,
      "output_file": "output/report.md",
      "guardrail": { "python": "valutatore.guardrails.check_report" },
      "guardrail_max_retries": 2,
      "agent": "presenter",
    },
  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Crew memory stays off: it persists across runs and would mix earlier pitches into a new evaluation
  "memory": false,

  // Automatically plan the execution strategy before running tasks
  // "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "researcher",
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {
    // Path of the pitch PDF to evaluate
    "pitch_path": "file/Pitch.pdf",
    // Filled by load_pitch with the text extracted from the PDF
    "pitch_text": "",
  },

  // Attaches the PDF at {pitch_path} to the crew before the tasks start
  "before_kickoff_callbacks": [{ "python": "valutatore.callbacks.load_pitch" }],
}
